/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; media-src 'self' https: blob:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/home.js
  Cache-Control: public, max-age=0, must-revalidate
/state.js
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate
/home.css
  Cache-Control: public, max-age=0, must-revalidate
/tv/tv.js
  Cache-Control: public, max-age=0, must-revalidate
/tv/tv.css
  Cache-Control: public, max-age=0, must-revalidate
/tv/config.js
  Cache-Control: public, max-age=0, must-revalidate

# Over-the-air TV app updates (ota/build.mjs): builds are immutable, the manifest is always revalidated.
/tv-app/v/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/tv-app/manifest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
